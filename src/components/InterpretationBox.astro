---
interface Props {
  title?: string;
}

const { title = "Comment lire ce résultat ?" } = Astro.props;
---

<aside class="my-6 rounded-lg border border-navy-700/20 bg-navy-50 p-5">
  <div class="flex items-center gap-2 mb-2">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-teal shrink-0">
      <circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/>
    </svg>
    <p class="font-semibold text-navy-900 text-sm uppercase tracking-wide">{title}</p>
  </div>
  <div class="text-sm text-slate-700 leading-relaxed [&_p]:mb-2 [&_p:last-child]:mb-0">
    <slot />
  </div>
</aside>
