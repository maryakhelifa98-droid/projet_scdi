---
const navItems = [
  { href: "/", label: "Accueil" },
  { href: "/etude", label: "Étude" },
  { href: "/classification", label: "Classification" },
  { href: "/methodologie", label: "Méthodologie" },
  { href: "/a-propos", label: "À propos" },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<header class="sticky top-0 z-50 bg-navy-950/95 backdrop-blur border-b border-navy-800">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 flex items-center justify-between h-16">
    <a href="/" class="flex items-center gap-2.5 shrink-0">
      <img src="/img/brand/icon.svg" alt="" width="36" height="36" class="rounded-full" />
      <span class="text-white font-extrabold tracking-tight text-lg leading-none">
        DATA WC26
      </span>
    </a>

    <nav aria-label="Navigation principale" class="hidden md:flex items-center gap-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "px-3 py-2 rounded-md text-sm font-medium transition-colors",
            isActive(item.href)
              ? "bg-navy-800 text-white"
              : "text-navy-100/80 hover:text-white hover:bg-navy-900",
          ]}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <details class="md:hidden relative">
      <summary class="list-none cursor-pointer text-white p-2 rounded-md hover:bg-navy-900" aria-label="Ouvrir le menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </summary>
      <nav aria-label="Navigation mobile" class="absolute right-0 mt-2 w-56 rounded-lg bg-navy-900 border border-navy-800 shadow-xl py-2">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "block px-4 py-2.5 text-sm font-medium",
              isActive(item.href) ? "text-white bg-navy-800" : "text-navy-100/80 hover:text-white hover:bg-navy-800",
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
